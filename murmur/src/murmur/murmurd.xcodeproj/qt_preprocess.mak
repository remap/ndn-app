MOC       = /Developer/Tools/Qt/moc
UIC       = /Developer/Tools/Qt/uic
LEX       = flex
LEXFLAGS  = 
YACC      = yacc
YACCFLAGS = -d
DEFINES       = -DRESTRICT=__restrict__ -DMUMBLE_VERSION_STRING=1.2.2 -DMURMUR -DUSE_DBUS -DUSE_BONJOUR -DQT_SQL_LIB -DQT_XML_LIB -DQT_NETWORK_LIB -DQT_CORE_LIB -DQT_SHARED
INCPATH       = -I/usr/local/Qt4.7/mkspecs/macx-xcode -I. -I/Library/Frameworks/QtCore.framework/Versions/4/Headers -I/usr/include/QtCore -I/Library/Frameworks/QtNetwork.framework/Versions/4/Headers -I/usr/include/QtNetwork -I/Library/Frameworks/QtXml.framework/Versions/4/Headers -I/usr/include/QtXml -I/Library/Frameworks/QtSql.framework/Versions/4/Headers -I/usr/include/QtSql -I/usr/include -I/Library/Frameworks/QtDBus.framework/Versions/4/Headers -I/usr/include/QtDBus -I../../src -I. -I/usr/local/include -I/MumbleDeveloper/x86-64/include -I/MumbleDeveloper/x86-64/include/boost_1_44_0 -I../bonjour -I. -I/usr/local/include -I/System/Library/Frameworks/CarbonCore.framework/Headers -F/Library/Frameworks
DEL_FILE  = rm -f
MOVE      = mv -f

IMAGES = 
PARSERS =
preprocess: $(PARSERS) compilers
clean preprocess_clean: parser_clean compiler_clean

parser_clean:
check: first

mocclean: compiler_moc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_source_make_all

compilers: Mumble.pb.cc ./moc_ACL.cpp ./moc_Channel.cpp ./moc_Connection.cpp\
	 ./moc_Server.cpp ./moc_ServerUser.cpp ./moc_Meta.cpp\
	 ./moc_RemoteUser.cpp ./moc_GroupManager.cpp ./moc_media_pro.cpp\
	 ./moc_UnixMurmur.cpp ./moc_DBus.cpp ./moc_bonjourserviceregister.cpp\
	 ./moc_BonjourServer.cpp
compiler_pb_make_all: Mumble.pb.cc
compiler_pb_clean:
	-$(DEL_FILE) Mumble.pb.cc
Mumble.pb.cc: ../Mumble.proto
	protoc --cpp_out=. -I. -I.. ../Mumble.proto

compiler_objective_c_make_all:
compiler_objective_c_clean:
compiler_moc_header_make_all: moc_ACL.cpp moc_Channel.cpp moc_Connection.cpp moc_Server.cpp moc_ServerUser.cpp moc_Meta.cpp moc_RemoteUser.cpp moc_GroupManager.cpp moc_media_pro.cpp moc_UnixMurmur.cpp moc_DBus.cpp moc_bonjourserviceregister.cpp moc_BonjourServer.cpp
